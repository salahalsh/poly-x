.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Generated figures (paper/analysis/s09_figures.py regenerates them)
paper/figures/*.png
paper/figures/*.pdf

# LaTeX build products
*.aux
*.bbl
*.blg
*.out
*.spl
*.synctex.gz
