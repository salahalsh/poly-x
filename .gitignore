# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Model binaries (too large for GitHub)
*.joblib
*.pkl
*.h5
*.pt
*.bin

# Training data (reference Zenodo DOI instead)
*.csv
# ...but the archived analysis outputs ARE the evidence for every table
# and figure in the paper, so they are tracked deliberately.
!paper/outputs/**/*.csv
!poly_x/data/*.csv

